#!/bin/sh
# 方案 E：给开机时钟一个正确基线（2026-11-09）
#
# ── 要解决的问题 ──────────────────────────────────────
# 本机没有 RTC，/etc/init.d/sysfixtime（START=00）会拿 /etc 下**最新文件 mtime**
# 当开机时钟。镜像里文件的 mtime 是构建时留下的旧时间（v18 全是 Nov 7 02:08），
# 于是开机时钟会比真实时间落后好几天，NTP 一同步就"往前跳"。
# 这个跳变会把刚发出去的 DHCP 租约瞬间判成已过期 → 后台租约列表空、
# 而且服务端不认为那个 IP 被占用，多客户端时有重复分配的风险。
#
# ── 做法 ──────────────────────────────────────────────
# NTP 一同步成功，就 touch 这个文件，把"当前已知正确的时间"记在它的 mtime 上。
# 下次开机 sysfixtime 扫 /etc 时会命中它，开机时钟 ≈ 上次同步时间，
# 跳变只剩"设备关机了多久"（几十秒~几分钟），远小于 12h 租约期。
# 顺带把日志时间戳、TLS 证书校验时间这些也都修正了。
#
# 注意：这治不了"刷完机的第一次开机"——那时 overlay 是空的、还没有这个文件。
# 那种情况靠 dhcp.lan.leasetime 调长来兜底（见交接文档）。

[ "$ACTION" = "stratum" ] || exit 0

now=$(date +%s)

# 时间明显不合理（早于 2020-01-01）就别记，免得把错误时间固化下来
[ "$now" -gt 1577836800 ] || exit 0

FILE=/etc/c2000-clock

if [ ! -f "$FILE" ]; then
	touch "$FILE"
	exit 0
fi

# stratum 变化可能比较频繁，超过 1 小时才写一次，减少 overlay 写入
old=$(date -r "$FILE" +%s 2>/dev/null) || old=0
[ $((now - old)) -gt 3600 ] && touch "$FILE"

exit 0
