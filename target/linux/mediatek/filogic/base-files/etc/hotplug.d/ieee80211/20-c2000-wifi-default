#!/bin/sh

[ -f /etc/c2000-wifi-default.done ] && exit 0
[ "${ACTION}" = "add" ] || exit 0
[ -f /etc/config/wireless ] || exit 0

changed=0

for r in $(uci -q show wireless | grep -E '=wifi-device$' | cut -d. -f2 | cut -d= -f1); do
	[ -z "$(uci -q get wireless.$r.country)" ] || continue
	uci set "wireless.$r.country=CN" && changed=1
done

: > /etc/c2000-wifi-default.done

[ "$changed" = 1 ] || exit 0

uci commit wireless
ubus call network.wireless reconf >/dev/null 2>&1

exit 0
