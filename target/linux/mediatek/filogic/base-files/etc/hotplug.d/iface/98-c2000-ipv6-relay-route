#!/bin/sh
#
# IPv6 relay 模式下，给 br-lan 补一条上游 /64 的 on-link 回程路由
#
# 背景
# ----
# 运营商只做 SLAAC、RA 里没有可委派前缀（无 PD），所以走 odhcpd 的 relay 方案：
# 把 eth2 收到的 RA 中继到 br-lan，内网设备直接用上游那个 /64 做 SLAAC。
# 实测内网设备确实能拿到 2409:8d44:xxxx:xxx::/64 的公网地址。
#
# 但路由器自己从来没有这个 /64 的 on-link 路由 —— br-lan 发出去的 RA 不会回环给
# 自己的协议栈，所以 br-lan 不可能靠 SLAAC 自配地址，也就不会生成前缀路由。
# 结果是：上游回来的包在路由表里匹配不上 br-lan，被默认路由又推回 5G 打转，
# 内网公网地址「有地址、不通」。
#
# 更麻烦的是 odhcpd 的 ndproxy_routing 会跟着邻居表给每台主机建 /128：
# 没有这条 /64 时它会把 /128 挂到 eth2（因为模组对任何地址都做无差别 NDP 应答，
# eth2 邻居表里什么地址都有），/128 比 /64 更具体 → 回程彻底走错。
#
# 补上这条 /64 之后，odhcpd 就会把每台主机的 /128 正确挂到 br-lan。
#
# 做法
# ----
# 从 eth2 的 SLAAC 地址推出 /64（SLAAC 前缀必为 /64），挂到 br-lan；
# 前缀变了先删旧的，避免切换基站后残留。
# 只加路由，不碰 network.wwan.proto —— 改 proto 会让 IPv4 掉线（2026-11-14 已踩）。
#

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wwan" ] || exit 0

DEV="${DEVICE:-eth2}"
[ -d "/proc/sys/net/ipv6/conf/$DEV" ] || DEV=eth2
[ -d "/proc/sys/net/ipv6/conf/$DEV" ] || exit 0

(
	# 等 accept_ra 生效 + RA 落地，最长约 66 秒（开机时模组拨号可能偏慢）
	sleep 6
	i=0
	PREFIX=""
	while [ "$i" -lt 30 ]; do
		ADDR=$(ip -6 addr show dev "$DEV" scope global 2>/dev/null | awk '/inet6 /{print $2; exit}')
		case "$ADDR" in
			*/64)
				PREFIX=$(echo "$ADDR" | cut -d/ -f1 | cut -d: -f1-4)"::/64"
				;;
		esac
		[ -n "$PREFIX" ] && break
		i=$((i + 1))
		sleep 2
	done

	[ -n "$PREFIX" ] || exit 0

	OLD=$(cat /tmp/.c2000-v6-prefix 2>/dev/null)
	if [ -n "$OLD" ] && [ "$OLD" != "$PREFIX" ]; then
		ip -6 route del "$OLD" dev br-lan 2>/dev/null
	fi

	ip -6 route replace "$PREFIX" dev br-lan 2>/dev/null
	echo "$PREFIX" > /tmp/.c2000-v6-prefix
) >/dev/null 2>&1 &

exit 0
