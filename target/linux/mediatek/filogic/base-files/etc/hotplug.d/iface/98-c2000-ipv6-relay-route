#!/bin/sh

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wwan" ] || exit 0

DEV="${DEVICE:-eth2}"
[ -d "/proc/sys/net/ipv6/conf/$DEV" ] || DEV=eth2
[ -d "/proc/sys/net/ipv6/conf/$DEV" ] || exit 0

(
	sleep 6
	i=0
	PREFIX=""
	while [ "$i" -lt 30 ]; do
		ADDR=$(ip -6 addr show dev "$DEV" scope global 2>/dev/null | awk '/inet6 /{print $2; exit}')
		case "$ADDR" in
			*/64)
				PREFIX=$(echo "$ADDR" | cut -d/ -f1 | cut -d: -f1-4)"::/64"
				;;
		esac
		[ -n "$PREFIX" ] && break
		i=$((i + 1))
		sleep 2
	done

	[ -n "$PREFIX" ] || exit 0

	OLD=$(cat /tmp/.c2000-v6-prefix 2>/dev/null)
	if [ -n "$OLD" ] && [ "$OLD" != "$PREFIX" ]; then
		ip -6 route del "$OLD" dev br-lan 2>/dev/null
	fi

	ip -6 route replace "$PREFIX" dev br-lan 2>/dev/null
	echo "$PREFIX" > /tmp/.c2000-v6-prefix
) >/dev/null 2>&1 &

exit 0
