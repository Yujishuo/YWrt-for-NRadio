#!/bin/sh

if [ ! -f /etc/config/network ]; then
	cat > /etc/config/network <<'EOF'
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00:c200:1::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'
	list ports 'eth1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.66.222'
	option netmask '255.255.255.0'
	option ip6assign '60'
EOF
fi

if [ -f /etc/shadow ]; then
	sed -i 's|^root:[^:]*:|root:$1$c2k0$Zj7WQGiYwdNgYmGLiDOJ50:|' /etc/shadow
fi

[ -f /etc/config/dropbear ] || touch /etc/config/dropbear
uci -q batch <<-EOF
	set dropbear.@dropbear[0].PasswordAuth='on'
	set dropbear.@dropbear[0].RootPasswordAuth='on'
	set dropbear.@dropbear[0].RootLogin='1'
	set dropbear.@dropbear[0].Port='22'
	commit dropbear
EOF

exit 0
