#!/bin/sh
TAG=c2000-mac
log() { logger -t "$TAG" "$*" 2>/dev/null; echo "$TAG: $*" >&2; }

if [ -n "${C2000_BDINFO_FILE:-}" ]; then
	BDIDEV="$C2000_BDINFO_FILE"
	log "使用调试用 bdinfo 文件 $BDIDEV"
else
	BDI=$(awk -F'"' 'tolower($2) ~ /bdinfo|bd_info|board/ {
			s = $1; sub(/^mtd/, "", s); sub(/:.*/, "", s); print s; exit
		}' /proc/mtd 2>/dev/null)
	if [ -z "${BDI:-}" ]; then
		log "找不到 bdinfo 分区，跳过 MAC 固定（网口仍可用，只是 MAC 随机）"
		exit 0
	fi
	BDIDEV="/dev/mtdblock$BDI"
fi
[ -r "$BDIDEV" ] || { log "$BDIDEV 不可读，跳过"; exit 0; }

RAW=$(dd if="$BDIDEV" 2>/dev/null \
	| tr -c '\11\12\15\40-\176' '\n' \
	| sed -n 's/^[[:space:]]*\(2fac_mac\|base_mac\|lan_mac\|ethaddr\|macaddr\|mac\)[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*$/\1 \2/p')

[ -n "${RAW:-}" ] || { log "bdinfo 里没有 MAC 字段，跳过"; exit 0; }

BASE=
USEDKEY=
for k in 2fac_mac base_mac lan_mac ethaddr macaddr mac; do
	val=$(printf '%s\n' "$RAW" | awk -v k="$k" '$1==k { print $2; exit }')
	[ -n "${val:-}" ] || continue

	h=$(printf '%s' "$val" | tr -cd '0-9a-fA-F' | tr 'a-f' 'A-F')
	if [ ${#h} -ne 12 ]; then
		log "键 $k 的值 '$val' 不是 12 位十六进制，试下一个"
		continue
	fi

	cand=$(printf '%s' "$h" | sed 's/\(..\)/\1:/g; s/:$//')

	if [ "$h" = "000000000000" ]; then
		log "键 $k 是全 0，试下一个"
		continue
	fi

	first=$((0x$(printf '%s' "$h" | cut -c1-2)))
	if [ $((first & 1)) -eq 1 ]; then
		log "键 $k 的值 '$cand' 是组播地址，试下一个"
		continue
	fi

	BASE="$cand"
	USEDKEY="$k"
	break
done

[ -n "${BASE:-}" ] || { log "bdinfo 里没找到可用的 MAC，跳过（网口仍可用，只是 MAC 随机）"; exit 0; }

PFX=${BASE%:*}
LAST=${BASE##*:}
N=$((0x$LAST))
if [ "$N" -ge 255 ]; then
	if [ "$N" -ge 1 ]; then
		M1=$(printf '%s:%02X' "$PFX" $((N - 1)))
		log "base 末字节为 0xFF，无法 +1；eth1 改用 -1 的 $M1"
	else
		M1="$BASE"
		log "base 末字节为 0x$LAST，无法调整；eth1 与 eth0 同 MAC"
	fi
else
	M1=$(printf '%s:%02X' "$PFX" $((N + 1)))
fi

if [ -n "${C2000_MAC_DRYRUN:-}" ]; then
	log "【干跑】来源键 $USEDKEY   eth0=$BASE  eth1=$M1"
	exit 0
fi

if ! uci -q get network.lan >/dev/null 2>&1; then
	log "network.lan 不存在，为避免破坏网络配置，跳过 MAC 写入"
	exit 0
fi

if uci -q batch <<-EOF
	set network.dev_eth0=device
	set network.dev_eth0.name='eth0'
	set network.dev_eth0.macaddr='$BASE'
	set network.dev_eth1=device
	set network.dev_eth1.name='eth1'
	set network.dev_eth1.macaddr='$M1'
	commit network
EOF
then
	log "已固定 MAC（来源 $USEDKEY）：eth0=$BASE eth1=$M1"
else
	log "写 uci 失败，保持原样"
	exit 1
fi

exit 0
