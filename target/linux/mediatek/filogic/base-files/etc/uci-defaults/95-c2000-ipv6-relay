#!/bin/sh

[ -f /etc/config/dhcp ] || exit 0

uci -q set dhcp.lan.ra='relay'
uci -q set dhcp.lan.dhcpv6='relay'
uci -q set dhcp.lan.ndp='relay'

uci -q set dhcp.wwan='dhcp'
uci -q set dhcp.wwan.interface='wwan'
uci -q set dhcp.wwan.ignore='1'
uci -q set dhcp.wwan.master='1'
uci -q set dhcp.wwan.ra='relay'
uci -q set dhcp.wwan.dhcpv6='relay'
uci -q delete dhcp.wwan.ndp

uci -q commit dhcp

exit 0
