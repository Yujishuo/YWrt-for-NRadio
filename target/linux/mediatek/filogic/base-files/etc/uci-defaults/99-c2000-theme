#!/bin/sh

[ -d /www/luci-static/vantage ] || exit 0

uci -q get luci.themes >/dev/null 2>&1 || uci -q set luci.themes=internal
uci -q set luci.themes.Vantage='/luci-static/vantage'
uci -q set luci.main.mediaurlbase='/luci-static/vantage'
uci -q commit luci

if ! uci -q get 'vantage_theme.@appearance[0]' >/dev/null 2>&1; then
	uci -q add vantage_theme appearance >/dev/null 2>&1
	uci -q commit vantage_theme 2>/dev/null
fi

exit 0
