#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1

CLOCK_FILE=/etc/c2000-clock
MIN_EPOCH=1577836800

record_now() {
	local now
	now=$(date +%s)
	[ "$now" -gt "$MIN_EPOCH" ] || return 0
	[ -f "$CLOCK_FILE" ] || : > "$CLOCK_FILE" 2>/dev/null
	touch "$CLOCK_FILE" 2>/dev/null
}

start_service() {
	[ -f "$CLOCK_FILE" ] || : > "$CLOCK_FILE" 2>/dev/null

	procd_open_instance
	procd_set_param command /usr/sbin/c2000-clockd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	record_now
	sync
}
