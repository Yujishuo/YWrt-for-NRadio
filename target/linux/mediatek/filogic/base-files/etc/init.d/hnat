#!/bin/sh /etc/rc.common

START=19
STOP=10

HNAT_PATH=/sys/kernel/debug/hnat

start() {
	. /lib/functions.sh

	local enabled ipv6 bind_rate
	config_load hnat
	config_get_bool enabled  config enabled   0
	config_get_bool ipv6     config ipv6      1
	config_get      bind_rate config bind_rate 30

	[ "$enabled" = "1" ] || {
		logger -t hnat "disabled in /etc/config/hnat，不加载驱动"
		return 0
	}

	ip link set hnat up 2>/dev/null

	modprobe mtkhnat || {
		logger -t hnat "modprobe mtkhnat 失败"
		return 1
	}

	local i=0
	while [ ! -d "$HNAT_PATH" ] && [ "$i" -lt 40 ]; do
		sleep 0.05 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	[ -d "$HNAT_PATH" ] || {
		logger -t hnat "mtkhnat 已加载但 $HNAT_PATH 不存在"
		return 1
	}

	echo "8 $ipv6"       > "$HNAT_PATH/hnat_setting" 2>/dev/null
	echo "11 $bind_rate" > "$HNAT_PATH/hnat_setting" 2>/dev/null

	echo 1 > "$HNAT_PATH/hook_toggle" 2>/dev/null

	logger -t hnat "enabled (ipv6=$ipv6 bind_rate=$bind_rate)"
	return 0
}

stop() {
	[ -d "$HNAT_PATH" ] || return 0
	echo 0 > "$HNAT_PATH/hook_toggle" 2>/dev/null
	logger -t hnat "hook disabled"
	return 0
}

restart() {
	stop
	start
}
