#!/bin/sh
. /usr/share/libubox/jshn.sh

env_get() {
	fw_printenv -n "$1" 2>/dev/null
}

running_system() {
	case "$(cat /proc/cmdline 2>/dev/null)" in
	*PARTLABEL=rootfs*) echo sd ;;
	*mtd*|*ubi*) echo nor ;;
	*) echo unknown ;;
	esac
}

target_system() {
	local a b
	a=$(env_get boot_system)
	b=$(env_get boot_from_sd)
	[ -n "$a$b" ] || { echo unknown; return; }
	if [ "$a" = "1" ] || [ "$b" = "1" ]; then
		echo sd
	else
		echo nor
	fi
}

cmd_status() {
	local usable=0
	fw_printenv boot_system >/dev/null 2>&1 && usable=1

	json_init
	json_add_boolean "available" "$usable"
	json_add_string "running" "$(running_system)"
	json_add_string "target" "$(target_system)"
	json_add_string "boot_system" "$(env_get boot_system)"
	json_add_string "boot_from_sd" "$(env_get boot_from_sd)"
	json_dump
}

cmd_switch() {
	local target value

	json_load "$(cat)"
	json_get_var target target
	json_cleanup

	case "$target" in
	sd)  value=1 ;;
	nor) value=0 ;;
	*)
		json_init
		json_add_boolean "ok" 0
		json_add_string "message" "unknown target: ${target:-<empty>}"
		json_dump
		return 0
		;;
	esac

	if ! fw_setenv boot_system "$value" 2>/dev/null; then
		json_init
		json_add_boolean "ok" 0
		json_add_string "message" "fw_setenv boot_system failed"
		json_dump
		return 0
	fi

	if ! fw_setenv boot_from_sd "$value" 2>/dev/null; then
		json_init
		json_add_boolean "ok" 0
		json_add_string "message" "fw_setenv boot_from_sd failed"
		json_dump
		return 0
	fi

	json_init
	json_add_boolean "ok" 1
	json_add_string "target" "$target"
	json_dump
}

case "$1" in
list)
	json_init
	json_add_object "status"
	json_close_object
	json_add_object "switch"
	json_add_string "target" "sd|nor"
	json_close_object
	json_dump
	;;
call)
	case "$2" in
	status) cmd_status ;;
	switch) cmd_switch ;;
	*)
		json_init
		json_add_boolean "ok" 0
		json_add_string "message" "unknown method"
		json_dump
		;;
	esac
	;;
esac
