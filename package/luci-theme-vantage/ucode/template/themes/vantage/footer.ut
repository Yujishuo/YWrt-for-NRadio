{#
 Vantage theme - footer.
 Only shown to logged-in users: error pages reach
 anonymous visitors too. The menu script is only loaded for a session.
 (The core header's L.env script still carries the LuCI build for
 everyone; see docs/luci-contract.md section 2.)
-#}
{% if (blank_page): %}
</div>
{% else %}
		</main>
{%
	const dist_ver = match(version.distversion ?? '', /^[0-9A-Za-z][0-9A-Za-z.+-]*/);
-%}
		<footer class="vt-foot">
{% if (ctx.authsession): %}
			<span>{{ entityencode(version.distname ?? 'OpenWrt', true) }}{{ dist_ver ? ' ' + entityencode(dist_ver[0], true) : '' }}</span>
			<span class="vt-foot-sep" aria-hidden="true">/</span>
			<span>openwrt-25.12</span>
{% endif %}
		</footer>
	</div>
</div>
{% endif %}
{% if (ctx.authsession && !blank_page): %}
<script>L.require('menu-vantage');</script>
{% endif %}
</body>
</html>
