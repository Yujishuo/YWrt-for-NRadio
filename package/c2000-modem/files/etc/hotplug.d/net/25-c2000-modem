#!/bin/sh
[ -n "$INTERFACE" ] || exit 0
[ -d "/sys/class/net/$INTERFACE/device" ] || exit 0
[ -x /usr/sbin/c2000-modem ] || exit 0

case "$ACTION" in
	add)
		( /usr/sbin/c2000-modem ensure >/dev/null 2>&1 & )
		;;
	remove)
		rm -f /tmp/c2000-modem/iface
		( /usr/sbin/c2000-modem status >/dev/null 2>&1 & )
		;;
esac

exit 0
