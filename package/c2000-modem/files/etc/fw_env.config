# /etc/fw_env.config —— uboot-envtools 的环境变量位置
#
# C2000 Ultra 的 u-boot 环境在 SPI-NOR 的 u-boot-env 分区（mtd1），
# 单扇区 64 KiB，环境本身也占 64 KiB。
#
#   fw_printenv              查看
#   fw_setenv boot_system 1 ; fw_setenv boot_from_sd 1   下次从 SD 卡系统启动
#   fw_setenv boot_system 0 ; fw_setenv boot_from_sd 0   下次从厂商 NOR 系统启动
# （出厂 env 里只有 boot_system，原厂页面写的是 boot_from_sd，两个都写最稳）
#
# dev		offset	size	sectorsize
/dev/mtd1	0x0000	0x10000	0x10000
