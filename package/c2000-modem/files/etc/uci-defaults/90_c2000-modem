#!/bin/sh

uci -q get network.wwan >/dev/null || {
	uci set network.wwan=interface
	uci set network.wwan.proto='dhcp'
	uci set network.wwan.metric='10'
	uci set network.wwan.auto='1'
	uci commit network
}

zone=$(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -1)
if [ -n "$zone" ]; then
	if ! uci -q get "firewall.$zone.network" | tr ' ' '\n' | grep -qx wwan; then
		uci add_list "firewall.$zone.network=wwan"
		uci commit firewall
	fi
fi

exit 0
